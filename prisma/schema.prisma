generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Barang {
  id         Int      @id @default(autoincrement())
  nama       String
  kategori   String
  stok       Int
  hargaBeli  Int
  hargaJual  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
